# AstraRoute AI — Environment Configuration
# Copy this file to .env and configure your keys as needed.

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="AstraRoute AI"

# Database Configuration:
# Default SQLite local database (zero-configuration):
DATABASE_URL=sqlite:///./astraroute.db

# Or Supabase / PostgreSQL Connection String:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# AI Provider API Keys (Optional):
# If keys are omitted or empty, AstraRoute automatically activates the
# high-fidelity realistic Simulator without crashing or blocking.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Global FinOps Policy Defaults
DEFAULT_MAX_BUDGET_PER_REQUEST=0.05
DEFAULT_MIN_QUALITY_THRESHOLD=0.70
DEFAULT_MAX_LATENCY_MS=4000
DEFAULT_MAX_RETRIES=2

# Default Multi-Objective Routing Weights (Sum = 1.0)
DEFAULT_WEIGHT_COST=0.40
DEFAULT_WEIGHT_QUALITY=0.35
DEFAULT_WEIGHT_LATENCY=0.15
DEFAULT_WEIGHT_RELIABILITY=0.10

